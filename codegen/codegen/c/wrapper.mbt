///|
/// C wrapper 生成结果（头文件 + 源文件） | C wrapper generation result (header + source)
#derive(Debug, Eq)
pub(all) struct CWrapperResult {
  header : String
  source : String
}

///|
pub extend CWrapperResult with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend CWrapperResult with Eq::{not_equal, equal}

///|
/// C 导出函数签名 | C export function signature
#derive(Debug, Eq)
pub(all) struct CExportFunc {
  name : String
  params : Array[(String, String)]
  return_type : String
}

///|
pub extend CExportFunc with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend CExportFunc with Eq::{not_equal, equal}

///|
/// C wrapper 生成器版本 | C wrapper generator version
pub fn c_wrapper_version() -> String {
  "moon-cross C wrapper v0.3.33"
}

///|
/// 生成 C wrapper 头文件骨架（向后兼容） | Generate C wrapper header skeleton (backward compatible)
pub fn generate_header(module_name : String) -> String {
  "#ifndef " +
  module_name +
  "_H\n#define " +
  module_name +
  "_H\n\n#include <stdint.h>\n#include \"moonbit.h\"\n\n#endif\n"
}

///|
/// 生成完整的 C wrapper 头文件（含函数声明 + 导出宏） | Generate full C wrapper header with declarations
pub fn generate_wrapper_header(
  funcs : Array[CExportFunc],
  module_name : String,
) -> String {
  let mut h = "#ifndef " + module_name + "_H\n#define " + module_name + "_H\n\n"
  h = h + "#include <stdint.h>\n#include \"moonbit.h\"\n\n"
  h = h + "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
  h = h +
    "#ifdef _WIN32\n#define MOONBIT_EXPORT __declspec(dllexport)\n#else\n#define MOONBIT_EXPORT __attribute__((visibility(\"default\")))\n#endif\n\n"
  for func in funcs {
    let param_str = format_c_params(func.params)
    let ret_type = c_type_string(func.return_type)
    h = h +
      "MOONBIT_EXPORT " +
      ret_type +
      " " +
      module_name +
      "_" +
      func.name +
      "(" +
      param_str +
      ");\n"
  }
  h = h + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif // " + module_name + "_H\n"
  h
}

///|
/// 生成完整的 C wrapper 源文件（含 marshalling + 生命周期管理） | Generate full C wrapper source with marshalling
pub fn generate_wrapper_source(
  funcs : Array[CExportFunc],
  module_name : String,
) -> String {
  let mut s = "// Auto-generated by moon-cross codegen v0.3.33\n"
  s = s + "// Module: " + module_name + "\n"
  s = s + "// DO NOT EDIT - regenerate with: moon-cross build\n\n"
  s = s + "#include \"" + module_name + ".h\"\n\n"
  s = s + "// MoonBit runtime initialization (lazy, thread-safe via static)\n"
  s = s + "static int moonbit_initialized = 0;\n\n"
  s = s + "static void ensure_moonbit_init(void) {\n"
  s = s + "  if (!moonbit_initialized) {\n"
  s = s + "    moonbit_init();\n"
  s = s + "    moonbit_initialized = 1;\n"
  s = s + "  }\n"
  s = s + "}\n\n"
  for func in funcs {
    s = s + generate_single_wrapper(func, module_name)
  }
  s
}

///|
/// 为单个函数生成 C wrapper（含 marshalling + GC 管理） | Generate wrapper for single function
pub fn generate_single_wrapper(
  func : CExportFunc,
  module_name : String,
) -> String {
  let param_str = format_c_params(func.params)
  let ret_type = c_type_string(func.return_type)
  let mut w = ""
  w = w + "// Wrapper for " + func.name + "\n"
  w = w +
    "MOONBIT_EXPORT " +
    ret_type +
    " " +
    module_name +
    "_" +
    func.name +
    "(" +
    param_str +
    ") {\n"
  w = w + "  ensure_moonbit_init();\n"
  for p in func.params {
    let mbt_type = @typesys.parse_moonbit_type(p.1)
    match mbt_type {
      Some(t) =>
        if @typesys.needs_gc_management(t) {
          w = w + "  // Marshal " + p.0 + ": " + p.1 + " -> MoonBit\n"
          w = w +
            "  moonbit_value_t mb_" +
            p.0 +
            " = " +
            @typesys.c_marshalling_in(t, p.0) +
            ";\n"
        }
      None => ()
    }
  }
  let call_params = format_mb_call_params(func.params)
  let ret_mbt = @typesys.parse_moonbit_type(func.return_type)
  w = w + "  // Call MoonBit function\n"
  match ret_mbt {
    Some(t) =>
      match t {
        UnitT =>
          w = w +
            "  moonbit_" +
            module_name +
            "_" +
            func.name +
            "(" +
            call_params +
            ");\n"
        _ =>
          w = w +
            "  moonbit_value_t mb_result = moonbit_" +
            module_name +
            "_" +
            func.name +
            "(" +
            call_params +
            ");\n"
      }
    None =>
      w = w + "  // Warning: unknown return type " + func.return_type + "\n"
  }
  for p in func.params {
    let mbt_type = @typesys.parse_moonbit_type(p.1)
    match mbt_type {
      Some(t) =>
        if @typesys.needs_gc_management(t) {
          w = w + "  // Release GC reference for " + p.0 + "\n"
          w = w + "  moonbit_gc_release(mb_" + p.0 + ");\n"
        }
      None => ()
    }
  }
  match ret_mbt {
    Some(t) =>
      match t {
        UnitT => w = w + "}\n\n"
        _ => {
          w = w + "  // Marshal result: MoonBit -> C\n"
          w = w +
            "  " +
            ret_type +
            " result = " +
            @typesys.c_marshalling_out(t, "mb_result") +
            ";\n"
          w = w + "  return result;\n"
          w = w + "}\n\n"
        }
      }
    None => {
      w = w + "  return 0;\n"
      w = w + "}\n\n"
    }
  }
  w
}

///|
/// 生成完整 C wrapper（头文件 + 源文件） | Generate complete C wrapper (header + source)
pub fn generate_full_wrapper(
  funcs : Array[CExportFunc],
  module_name : String,
) -> CWrapperResult {
  {
    header: generate_wrapper_header(funcs, module_name),
    source: generate_wrapper_source(funcs, module_name),
  }
}

///|
/// C 类型字符串映射（复用 typesys） | C type string mapping (reuses typesys)
pub fn c_type_string(mbt_type : String) -> String {
  match @typesys.parse_moonbit_type(mbt_type) {
    Some(t) => @typesys.moonbit_to_c_string(t)
    None => "void*"
  }
}

///|
/// 格式化 C 参数列表 | Format C parameter list
pub fn format_c_params(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    parts.push(c_type_string(p.1) + " " + p.0)
  }
  join_strings(parts, ", ")
}

///|
/// 格式化 MoonBit 调用参数（使用 marshalled 变量） | Format MoonBit call params with marshalled vars
pub fn format_mb_call_params(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    let mbt_type = @typesys.parse_moonbit_type(p.1)
    match mbt_type {
      Some(t) =>
        if @typesys.needs_gc_management(t) {
          parts.push("mb_" + p.0)
        } else {
          parts.push(p.0)
        }
      None => parts.push(p.0)
    }
  }
  join_strings(parts, ", ")
}

///|
/// 连接字符串数组 | Join string array
fn join_strings(parts : Array[String], sep : String) -> String {
  let mut result = ""
  let mut first = true
  for p in parts {
    if !first {
      result = result + sep
    }
    result = result + p
    first = false
  }
  result
}

///|
/// CExportFunc 实现 Named trait | CExportFunc implements Named
pub fn CExportFunc::name(self : CExportFunc) -> String {
  self.name
}
