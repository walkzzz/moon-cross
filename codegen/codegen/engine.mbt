///|
/// 代码生成结果（文件名 + 内容） | Code generation result (filename + content)
pub(all) struct CodegenResult {
  filename : String
  content : String
} derive(Debug, Eq)
pub extend CodegenResult with @moonbitlang/core/debug.Debug::{to_repr}
pub extend CodegenResult with Eq::{not_equal, equal}

///|
/// 导出函数签名 | Export function signature
pub(all) struct ExportFunction {
  name : String
  params : Array[(String, String)]
  return_type : String
} derive(Debug, Eq)
pub extend ExportFunction with @moonbitlang/core/debug.Debug::{to_repr}
pub extend ExportFunction with Eq::{not_equal, equal}

///|
/// 跨平台代码生成结果 | Cross-platform code generation result
pub(all) struct CrossPlatformCode {
  platform : String
  filename : String
  content : String
} derive(Debug, Eq)
pub extend CrossPlatformCode with @moonbitlang/core/debug.Debug::{to_repr}
pub extend CrossPlatformCode with Eq::{not_equal, equal}

///|
/// 代码生成器版本 | Code generator version
pub fn codegen_version() -> String {
  "moon-cross codegen v0.3.22"
}

///|
/// 生成 C 头文件导出宏 | Generate C. C header export macro
pub fn generate_export_macro() -> String {
  "#ifdef _WIN32\n#define MOONBIT_EXPORT __declspec(dllexport)\n#else\n#define MOONBIT_EXPORT __attribute__((visibility(\"default\")))\n#endif\n"
}

///|
/// 生成 C 适配层 | Generate C adapter layer
pub fn generate_c_adapter(funcs : Array[ExportFunction], module_name : String) -> CodegenResult {
  let header = generate_export_macro() + "\n// Auto-generated by moon-cross codegen\n// Module: " + module_name + "\n\n"
  let mut body = header
  for func in funcs {
    let param_str = format_params_c(func.params)
    body = body + "MOONBIT_EXPORT " + c_type(func.return_type) + " " + module_name + "_" + func.name + "(" + param_str + ");\n"
  }
  body = body + "\n// Implementation\n"
  for func in funcs {
      let param_str = format_params_c(func.params)
      let call_params = format_call_params(func.params)
    body = body + "MOONBIT_EXPORT " + c_type(func.return_type) + " " + module_name + "_" + func.name + "(" + param_str + ") {\n"
    body = body + "  // Initialize MoonBit runtime\n"
    body = body + "  // Call " + func.name + "(" + call_params + ")\n"
    body = body + "  // Convert result to C type\n"
    body = body + "  // Return result\n"
    body = body + "  return 0; // placeholder\n"
    body = body + "}\n\n"
  }
  { filename: module_name + "_adapter.c", content: body, }
}

///|
/// 生成 iOS Swift interop | Generate iOS Swift interop
pub fn generate_swift_interop(funcs : Array[ExportFunction], module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n// Platform: iOS (Swift interop)\n// Module: " + module_name + "\n\n"
  content = content + "import Foundation\n\n"
  for func in funcs {
    let param_str = format_params_swift(func.params)
    content = content + "func " + func.name + "(" + param_str + ") -> " + swift_type(func.return_type) + " {\n"
    content = content + "    // Call native " + module_name + "_" + func.name + "\n"
    content = content + "    // Convert MoonBit result to Swift type\n"
    content = content + "    fatalError(\"Not implemented\")\n"
    content = content + "}\n\n"
  }
  { platform: "ios", filename: module_name + ".swift", content, }
}

///|
/// 生成 Android JNI 声明 | Generate Android JNI declaration
pub fn generate_jni_binding(funcs : Array[ExportFunction], module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n// Platform: Android (JNI)\n// Module: " + module_name + "\n\n"
  content = content + "package com.walkzzz." + module_name + ";\n\n"
  content = content + "public class " + capitalize(module_name) + " {\n"
  content = content + "    static {\n"
  content = content + "        System.loadLibrary(\"" + module_name + "\");\n"
  content = content + "    }\n\n"
  for func in funcs {
    let param_str = format_params_kotlin(func.params)
    content = content + "    public static native " + kotlin_type(func.return_type) + " " + func.name + "(" + param_str + ");\n"
  }
  content = content + "}\n"
  { platform: "android", filename: capitalize(module_name) + ".kt", content, }
}

///|
/// 生成 Windows C# DllImport | Generate Windows C# DllImport
pub fn generate_dllimport(funcs : Array[ExportFunction], module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n// Platform: Windows (C# DllImport)\n// Module: " + module_name + "\n\n"
  content = content + "using System.Runtime.InteropServices;\n\n"
  content = content + "public class " + capitalize(module_name) + " {\n"
  for func in funcs {
    let param_str = format_params_csharp(func.params)
    content = content + "    [DllImport(\"" + module_name + ".dll\")]\n"
    content = content + "    public static extern " + csharp_type(func.return_type) + " " + func.name + "(" + "" + param_str + ");\n"
  }
  content = content + "}\n"
  { platform: "windows", filename: capitalize(module_name) + ".cs", content, }
}

///|
/// 生成鸿蒙 NAPI 声明 | Generate HarmonyOS NAPI declaration
pub fn generate_napi_binding(funcs : Array[ExportFunction], module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n// Platform: HarmonyOS (NAPI)\n// Module: " + module_name + "\n\n"
  content = content + "import native from '" + module_name + ".so'\n\n"
  for func in funcs {
    let param_str = format_params_arkts(func.params)
    content = content + "export function " + func.name + "(" + param_str + "): " + arkts_type(func.return_type) + " {\n"
    content = content + "    return native." + func.name + "(/* args */)\n"
    content = content + "}\n\n"
  }
  { platform: "ohos", filename: module_name + ".ts", content, }
}

///|
/// 生成 Linux C 头文件 | Generate Linux C header
pub fn generate_linux_header(funcs : Array[ExportFunction], module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n// Platform: Linux (C header)\n// Module: " + module_name + "\n\n"
  content = content + "#ifndef " + uppercase(module_name) + "_H\n"
  content = content + "#define " + uppercase(module_name) + "_H\n\n"
  for func in funcs {
    let param_str = format_params_c(func.params)
    content = content + c_type(func.return_type) + " " + module_name + "_" + func.name + "(" + param_str + ");\n"
  }
  content = content + "\n#endif // " + uppercase(module_name) + "_H\n"
  { platform: "linux", filename: module_name + ".h", content, }
}

///|
/// 一次性生成所有平台代码 | Generate all platform code at once
pub fn generate_all_platforms(funcs : Array[ExportFunction], module_name : String) -> Array[CrossPlatformCode] {
  [
    generate_swift_interop(funcs, module_name),
    generate_jni_binding(funcs, module_name),
    generate_dllimport(funcs, module_name),
    generate_napi_binding(funcs, module_name),
    generate_linux_header(funcs, module_name),
  ]
}

///|
/// C 类型映射 | C type mapping
fn c_type(t : String) -> String {
  match t {
    "Int" => "int32_t"
    "Double" => "double"
    "Bool" => "int32_t"
    "String" => "const char*"
    "Unit" => "void"
    _ => "void*"
  }
}

///|
/// Swift 类型映射 | Swift type mapping
fn swift_type(t : String) -> String {
  match t {
    "Int" => "Int32"
    "Double" => "Double"
    "Bool" => "Bool"
    "String" => "String"
    "Unit" => "Void"
    _ => "UnsafePointer<OpaquePointer>"
  }
}

///|
/// Kotlin 类型映射 | Kotlin type mapping
fn kotlin_type(t : String) -> String {
  match t {
    "Int" => "Int"
    "Double" => "Double"
    "Bool" => "Boolean"
    "String" => "String"
    "Unit" => "Unit"
    _ => "Long"
  }
}

///|
/// C# 类型映射 | C# type mapping
fn csharp_type(t : String) -> String {
  match t {
    "Int" => "int"
    "Double" => "double"
    "Bool" => "bool"
    "String" => "string"
    "Unit" => "void"
    _ => "IntPtr"
  }
}

///|
/// ArkTS 类型映射 | ArkTS type mapping
fn arkts_type(t : String) -> String {
  match t {
    "Int" => "number"
    "Double" => "number"
    "Bool" => "boolean"
    "String" => "string"
    "Unit" => "void"
    _ => "Object"
  }
}

///|
/// 格式化 C 参数 | Format C parameters
fn format_params_c(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    parts.push(c_type(p.1) + " " + p.0)
  }
  join_strings(parts, ", ")
}

///|
/// 格式化 Swift 参数 | Format Swift parameters
fn format_params_swift(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    parts.push(p.0 + ": " + swift_type(p.1))
  }
  join_strings(parts, ", ")
}

///|
/// 格式化 Kotlin 参数 | Format Kotlin parameters
fn format_params_kotlin(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    parts.push(p.0 + ": " + kotlin_type(p.1))
  }
  join_strings(parts, ", ")
}

///|
/// 格式化 C# 参数 | Format C# parameters
fn format_params_csharp(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    parts.push(csharp_type(p.1) + " " + p.0)
  }
  join_strings(parts, ", ")
}

///|
/// 格式化 ArkTS 参数 | Format ArkTS parameters
fn format_params_arkts(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    parts.push(p.0 + ": " + arkts_type(p.1))
  }
  join_strings(parts, ", ")
}

///|
/// 格式化调用参数 | Format call parameters
fn format_call_params(params : Array[(String, String)]) -> String {
  let parts = []
  for p in params {
    parts.push(p.0)
  }
  join_strings(parts, ", ")
}

///|
/// 连接字符串数组 | Join string array
fn join_strings(parts : Array[String], sep : String) -> String {
  let mut result = ""
  let mut first = true
  for p in parts {
    if !first {
      result = result + sep
    }
    result = result + p
    first = false
  }
  result
}

///|
/// 首字母大写 | Capitalize first letter
fn capitalize(s : String) -> String {
  match s {
    "pinyin" => "Pinyin"
    "pinyin_integration" => "PinyinIntegration"
    _ => s
  }
}

///|
/// 转大写 | Convert to uppercase
fn uppercase(s : String) -> String {
  match s {
    "pinyin" => "PINYIN"
    "pinyin_integration" => "PINYIN_INTEGRATION"
    _ => s
  }
}

///|
/// 生成跨平台 Makefile | Generate cross-platform Makefile
pub fn generate_makefile(module_name : String) -> CrossPlatformCode {
  let mut content = "# Auto-generated by moon-cross codegen\n"
  content = content + "# Module: " + module_name + "\n\n"
  content = content + "PLATFORMS = ios android windows ohos linux\n\n"
  content = content + "all: $(PLATFORMS)\n\n"
  content = content + "ios:\n"
  content = content + "\txcrun clang -target arm64-apple-ios -shared -o lib" + module_name + ".dylib " + module_name + "_adapter.c\n\n"
  content = content + "android:\n"
  content = content + "\t$(NDK)/clang -target aarch64-linux-android24 -shared -o lib" + module_name + ".so " + module_name + "_adapter.c\n\n"
  content = content + "windows:\n"
  content = content + "\tclang-cl -LD -o " + module_name + ".dll " + module_name + "_adapter.c\n\n"
  content = content + "ohos:\n"
  content = content + "\t$(OHOS_SDK)/clang -target aarch64-linux-ohos -shared -o lib" + module_name + ".so " + module_name + "_adapter.c\n\n"
  content = content + "linux:\n"
  content = content + "\tclang -shared -fPIC -o lib" + module_name + ".so " + module_name + "_adapter.c\n\n"
  content = content + "clean:\n"
  content = content + "\trm -f lib" + module_name + ".dylib lib" + module_name + ".so " + module_name + ".dll\n"
  { platform: "all", filename: "Makefile", content, }
}

///|
/// 生成 GitHub Actions CI/CD | Generate GitHub Actions CI/CD
pub fn generate_github_actions(module_name : String) -> CrossPlatformCode {
  let mut content = "# Auto-generated by moon-cross codegen\n"
  content = content + "# CI/CD for " + module_name + " cross-platform build\n\n"
  content = content + "name: Build " + module_name + "\n\n"
  content = content + "on: [push, pull_request]\n\n"
  content = content + "jobs:\n"
  content = content + "  build-ios:\n"
  content = content + "    runs-on: macos-latest\n"
  content = content + "    steps:\n"
  content = content + "      - uses: actions/checkout@v4\n"
  content = content + "      - name: Build iOS\n"
  content = content + "        run: make ios\n\n"
  content = content + "  build-android:\n"
  content = content + "    runs-on: ubuntu-latest\n"
  content = content + "    steps:\n"
  content = content + "      - uses: actions/checkout@v4\n"
  content = content + "      - name: Setup NDK\n"
  content = content + "        run: echo \"NDK=$ANDROID_NDK/toolchains/llvm/prebuilt/linux-x86_64/bin\"\n"
  content = content + "      - name: Build Android\n"
  content = content + "        run: make android\n\n"
  content = content + "  build-windows:\n"
  content = content + "    runs-on: windows-latest\n"
  content = content + "    steps:\n"
  content = content + "      - uses: actions/checkout@v4\n"
  content = content + "      - name: Build Windows\n"
  content = content + "        run: make windows\n\n"
  content = content + "  build-ohos:\n"
  content = content + "    runs-on: ubuntu-latest\n"
  content = content + "    steps:\n"
  content = content + "      - uses: actions/checkout@v4\n"
  content = content + "      - name: Build HarmonyOS\n"
  content = content + "        run: make ohos\n\n"
  content = content + "  build-linux:\n"
  content = content + "    runs-on: ubuntu-latest\n"
  content = content + "    steps:\n"
  content = content + "      - uses: actions/checkout@v4\n"
  content = content + "      - name: Build Linux\n"
  content = content + "        run: make linux\n"
  { platform: "ci", filename: "build.yml", content, }
}

///|
/// 生成 iOS Swift Package | Generate iOS Swift Package
pub fn generate_swift_package(module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n"
  content = content + "// swift-tools-version: 5.9\n\n"
  content = content + "import PackageDescription\n\n"
  content = content + "let package = Package(\n"
  content = content + "    name: \"" + capitalize(module_name) + "\",\n"
  content = content + "    products: [\n"
  content = content + "        .library(name: \"" + capitalize(module_name) + "\", targets: [\"" + capitalize(module_name) + "\"]),\n"
  content = content + "    ],\n"
  content = content + "    targets: [\n"
  content = content + "        .target(name: \"" + capitalize(module_name) + "\", path: \"src\"),\n"
  content = content + "    ]\n"
  content = content + ")"
  { platform: "ios", filename: "Package.swift", content, }
}

///|
/// 生成 Android Gradle 配置 | Generate Android Gradle config
pub fn generate_gradle_config(module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n"
  content = content + "plugins {\n"
  content = content + "    id(\"com.android.library\")\n"
  content = content + "    id(\"kotlin-android\")\n"
  content = content + "}\n\n"
  content = content + "android {\n"
  content = content + "    namespace = \"com.walkzzz." + module_name + "\"\n"
  content = content + "    compileSdk = 34\n\n"
  content = content + "    defaultConfig {\n"
  content = content + "        minSdk = 24\n"
  content = content + "        externalNativeBuild {\n"
  content = content + "            cmake {\n"
  content = content + "                abiFilters(\"arm64-v8a\", \"x86_64\")\n"
  content = content + "            }\n"
  content = content + "        }\n"
  content = content + "    }\n"
  content = content + "    externalNativeBuild {\n"
  content = content + "        cmake { path = file(\"CMakeLists.txt\") }\n"
  content = content + "    }\n"
  content = content + "}"
  { platform: "android", filename: "build.gradle.kts", content, }
}

///|
/// 生成鸿蒙 build-profile | Generate HarmonyOS build-profile
pub fn generate_ohos_build_profile(module_name : String) -> CrossPlatformCode {
  let mut content = "// Auto-generated by moon-cross codegen\n"
  content = content + "{\n"
  content = content + "  \"app\": {\n"
  content = content + "    \"signingConfigs\": [],\n"
  content = content + "    \"products\": [{\n"
  content = content + "      \"name\": \"default\",\n"
  content = content + "      \"signingConfig\": \"default\"\n"
  content = content + "    }]\n"
  content = content + "  },\n"
  content = content + "  \"modules\": [{\n"
  content = content + "    \"name\": \"" + module_name + "\",\n"
  content = content + "    \"srcPath\": \".\",\n"
  content = content + "    \"targets\": [{\n"
  content = content + "      \"name\": \"default\",\n"
  content = content + "      \"applyToProducts\": [\"default\"]\n"
  content = content + "    }]\n"
  content = content + "  }]\n"
  content = content + "}"
  { platform: "ohos", filename: "build-profile.json5", content, }
}

///|
/// 生成完整跨平台工程 | Generate complete cross-platform project
pub fn generate_project(funcs : Array[ExportFunction], module_name : String) -> Array[CrossPlatformCode] {
  let result = []
  let c_adapter = generate_c_adapter(funcs, module_name)
  result.push({ platform: "c", filename: c_adapter.filename, content: c_adapter.content, })
  for code in generate_all_platforms(funcs, module_name) {
    result.push(code)
  }
  result.push(generate_makefile(module_name))
  result.push(generate_github_actions(module_name))
  result.push(generate_swift_package(module_name))
  result.push(generate_gradle_config(module_name))
  result.push(generate_ohos_build_profile(module_name))
  result
}

///|
/// 生成跨平台 README | Generate cross-platform README
pub fn generate_readme(funcs : Array[ExportFunction], module_name : String) -> CrossPlatformCode {
  let mut content = "# " + capitalize(module_name) + "\n\n"
  content = content + "Auto-generated by moon-cross codegen\n\n"
  content = content + "## Exported Functions\n\n"
  content = content + "| Function | Parameters | Return |\n"
  content = content + "|----------|-----------|--------|\n"
  for func in funcs {
    let mut params = ""
    let mut first = true
    for p in func.params {
      if !first {
        params = params + ", "
      }
      params = params + p.0
      first = false
    }
    content = content + "| " + func.name + " | " + params + " | " + func.return_type + " |\n"
  }
  content = content + "\n## Supported Platforms\n\n"
  content = content + "- iOS (Swift interop)\n"
  content = content + "- Android (JNI)\n"
  content = content + "- Windows (DllImport)\n"
  content = content + "- HarmonyOS (NAPI)\n"
  content = content + "- Linux (C header)\n"
  content = content + "\n## Build\n\n"
  content = content + "```bash\nmake all\n```\n"
  { platform: "docs", filename: "README.md", content, }
}

///|
/// CodegenResult 实现 Named trait | CodegenResult implements Named
pub impl @trait.Named for CodegenResult with name(self) {
  self.filename
}
pub extend CodegenResult with @trait.Named::{name}