{
  "version": 1,
  "module_path": "bobzhang/toml",
  "package_name": "bobzhang/toml",
  "targets": ["ios", "android", "windows", "ohos"],
  "functions": [
    {
      "name": "toml_parse",
      "params": [{ "name": "input", "typ": "String" }],
      "return_type": "TomlValue"
    },
    {
      "name": "toml_to_string",
      "params": [{ "name": "value", "typ": "TomlValue" }],
      "return_type": "String"
    },
    {
      "name": "toml_get",
      "params": [
        { "name": "table", "typ": "TomlValue" },
        { "name": "key", "typ": "String" }
      ],
      "return_type": "TomlValue"
    },
    {
      "name": "toml_get_string",
      "params": [
        { "name": "table", "typ": "TomlValue" },
        { "name": "key", "typ": "String" }
      ],
      "return_type": "String"
    },
    {
      "name": "toml_get_int",
      "params": [
        { "name": "table", "typ": "TomlValue" },
        { "name": "key", "typ": "String" }
      ],
      "return_type": "Int"
    },
    {
      "name": "toml_get_double",
      "params": [
        { "name": "table", "typ": "TomlValue" },
        { "name": "key", "typ": "String" }
      ],
      "return_type": "Double"
    },
    {
      "name": "toml_get_bool",
      "params": [
        { "name": "table", "typ": "TomlValue" },
        { "name": "key", "typ": "String" }
      ],
      "return_type": "Bool"
    },
    {
      "name": "toml_value_type",
      "params": [{ "name": "value", "typ": "TomlValue" }],
      "return_type": "String"
    },
    {
      "name": "toml_table_keys",
      "params": [{ "name": "table", "typ": "TomlValue" }],
      "return_type": "Array"
    },
    {
      "name": "toml_array_length",
      "params": [{ "name": "array", "typ": "TomlValue" }],
      "return_type": "Int"
    }
  ],
  "types": [
    {
      "name": "TomlValue",
      "fields": [
        { "name": "Table", "typ": "Unit" },
        { "name": "Array", "typ": "Unit" },
        { "name": "String", "typ": "Unit" },
        { "name": "Int", "typ": "Unit" },
        { "name": "Double", "typ": "Unit" },
        { "name": "Bool", "typ": "Unit" },
        { "name": "Datetime", "typ": "Unit" },
        { "name": "Null", "typ": "Unit" }
      ]
    },
    {
      "name": "TomlError",
      "fields": [
        { "name": "ParseError", "typ": "String" },
        { "name": "TypeError", "typ": "String" },
        { "name": "KeyError", "typ": "String" }
      ]
    }
  ]
}