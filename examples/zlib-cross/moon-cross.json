    },
    {
      "name": "deflate_compress",
      "params": [{ "name": "data", "typ": "Bytes" }],
      "return_type": "Bytes"
    },
    {
      "name": "deflate_decompress",
      "params": [{ "name": "data", "typ": "Bytes" }],
      "return_type": "Bytes"
    },
    {
      "name": "gzip_compress",
      "params": [{ "name": "data", "typ": "Bytes" }],
      "return_type": "Bytes"
    },
    {
      "name": "gzip_decompress",
      "params": [{ "name": "data", "typ": "Bytes" }],
      "return_type": "Bytes"
    },
    {
