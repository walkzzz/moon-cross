///|
/// 编译执行结果 | Compilation execution result
#derive(Debug, Eq)
pub(all) struct CompileResult {
  success : Bool
  command : String
  output_path : String
  error_message : String
}

///|
pub extend CompileResult with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend CompileResult with Eq::{not_equal, equal}

///|
/// 编译步骤 | Compilation step
#derive(Debug, Eq)
pub(all) enum CompileStep {
  GenerateCode(String)
  Compile(String)
  Link(String)
  Package(String)
}

///|
pub extend CompileStep with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend CompileStep with Eq::{not_equal, equal}

///|
/// 构建脚本配置 | Build script configuration
#derive(Debug, Eq)
pub(all) struct BuildScriptConfig {
  module_name : String
  platforms : Array[String]
  output_dir : String
  source_files : Array[String]
}

///|
pub extend BuildScriptConfig with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend BuildScriptConfig with Eq::{not_equal, equal}

///|
/// 编译执行器版本 | Compile executor version
pub fn executor_version() -> String {
  "moon-cross executor v0.3.33"
}

///|
/// 生成构建脚本（可执行 shell script） | Generate build script (executable shell script)
pub fn generate_build_script(config : BuildScriptConfig) -> String {
  let mut script = "#!/bin/bash\nset -e\n\n"
  script = script + "# Auto-generated by moon-cross v0.3.33\n"
  script = script + "# Module: " + config.module_name + "\n"
  script = script + "# Platforms: " + join_str(config.platforms, " ") + "\n\n"
  script = script + "OUTPUT_DIR=\"" + config.output_dir + "\"\n"
  script = script + "MODULE=\"" + config.module_name + "\"\n\n"
  for platform in config.platforms {
    script = script + generate_platform_build_block(platform, config)
  }
  script = script + "\necho \"Build completed successfully.\"\n"
  script
}

///|
/// 生成平台构建块 | Generate platform build block
pub fn generate_platform_build_block(
  platform : String,
  config : BuildScriptConfig,
) -> String {
  let mut block = "# Build for " + platform + "\n"
  block = block + "echo \"Building for " + platform + "...\"\n"
  block = block + "mkdir -p \"$OUTPUT_DIR/" + platform + "\"\n"
  let sources = join_str(config.source_files, " ")
  match platform {
    "linux" =>
      block = block +
        "gcc -shared -fPIC -o \"$OUTPUT_DIR/" +
        platform +
        "/lib$MODULE.so\" " +
        sources +
        "\n"
    "android" =>
      block = block +
        "$NDK_CLANG --target=aarch64-linux-android24 -shared -o \"$OUTPUT_DIR/" +
        platform +
        "/lib$MODULE.so\" " +
        sources +
        "\n"
    "ios" =>
      block = block +
        "xcrun clang -target arm64-apple-ios -shared -o \"$OUTPUT_DIR/" +
        platform +
        "/lib$MODULE.dylib\" " +
        sources +
        "\n"
    "windows" =>
      block = block +
        "clang-cl -LD -o \"$OUTPUT_DIR/" +
        platform +
        "/$MODULE.dll\" " +
        sources +
        "\n"
    "ohos" =>
      block = block +
        "$OHOS_CLANG --target=aarch64-linux-ohos -shared -o \"$OUTPUT_DIR/" +
        platform +
        "/lib$MODULE.so\" " +
        sources +
        "\n"
    _ => block = block + "echo \"Unknown platform: " + platform + "\"\n"
  }
  block = block + "\n"
  block
}

///|
/// 生成编译计划 | Generate compilation plan
pub fn generate_compile_plan(config : BuildScriptConfig) -> Array[CompileStep] {
  let steps : Array[CompileStep] = []
  steps.push(GenerateCode("Generate C adapter for " + config.module_name))
  for platform in config.platforms {
    steps.push(Compile("Compile " + platform + " (" + config.module_name + ")"))
    steps.push(Link("Link " + platform + " (" + config.module_name + ")"))
    steps.push(Package("Package " + platform + " (" + config.module_name + ")"))
  }
  steps
}

///|
/// 模拟编译执行（返回预期结果） | Simulate compile execution (returns expected result)
pub fn simulate_compile(
  command : String,
  output_path : String,
) -> CompileResult {
  { success: true, command, output_path, error_message: "", }
}

///|
/// 编译失败结果 | Compile failure result
pub fn compile_failure(command : String, error : String) -> CompileResult {
  { success: false, command, output_path: "", error_message: error, }
}

///|
/// 生成 Windows 批处理脚本 | Generate Windows batch script
pub fn generate_bat_script(config : BuildScriptConfig) -> String {
  let mut script = "@echo off\nsetlocal\n\n"
  script = script + "REM Auto-generated by moon-cross v0.3.33\n"
  script = script + "set OUTPUT_DIR=" + config.output_dir + "\n"
  script = script + "set MODULE=" + config.module_name + "\n\n"
  for platform in config.platforms {
    script = script + "echo Building for " + platform + "...\n"
    script = script +
      "if not exist \"%OUTPUT_DIR%/" +
      platform +
      "\" mkdir \"%OUTPUT_DIR%/" +
      platform +
      "\"\n"
  }
  script = script + "\necho Build completed.\n"
  script
}

///|
/// 默认构建脚本配置 | Default build script config
pub fn default_build_config(module_name : String) -> BuildScriptConfig {
  {
    module_name,
    platforms: ["linux", "android", "ios", "windows", "ohos"],
    output_dir: "./build",
    source_files: [module_name + "_adapter.c"],
  }
}

///|
/// 连接字符串数组 | Join string array
fn join_str(parts : Array[String], sep : String) -> String {
  let mut result = ""
  let mut first = true
  for p in parts {
    if !first {
      result = result + sep
    }
    result = result + p
    first = false
  }
  result
}

///|
/// CompileResult 实现 Named trait | CompileResult implements Named
pub impl @trait.Named for CompileResult with fn name(self) {
  self.output_path
}

///|
pub extend CompileResult with @trait.Named::{name}

///|
/// CompileResult 实现 Checkable trait | CompileResult implements Checkable
pub impl @trait.Checkable for CompileResult with fn check(self) {
  self.success
}

///|
pub extend CompileResult with @trait.Checkable::{check}

///|
/// CompileResult 实现 Hashable trait | CompileResult implements Hashable
pub impl @trait.Hashable for CompileResult with fn hash(self) {
  @trait.Named::name(self).length()
}

///|
pub extend CompileResult with @trait.Hashable::{hash}

///|
/// BuildScriptConfig 实现 Named trait | BuildScriptConfig implements Named
pub impl @trait.Named for BuildScriptConfig with fn name(self) {
  self.module_name
}

///|
pub extend BuildScriptConfig with @trait.Named::{name}

///|
/// BuildScriptConfig 实现 Hashable trait | BuildScriptConfig implements Hashable
pub impl @trait.Hashable for BuildScriptConfig with fn hash(self) {
  @trait.Named::name(self).length()
}

///|
pub extend BuildScriptConfig with @trait.Hashable::{hash}
