///|
/// CLI 命令实现 — 8 个命令真实读写磁盘 | CLI command implementations — 8 real commands with disk IO

///|
/// CLI 命令分发（async，含真实文件操作） | CLI command dispatch (async, with real file operations)
pub async fn run_cli(args : Array[String]) -> String raise @core.MoonCrossError {
  if args.length() == 0 {
    return format_help()
  }
  let command = args[0]
  match command {
    "help" | "--help" | "-h" => format_help()
    "version" | "--version" | "-v" => format_version()
    "init" => cmd_init(args)
    "build" => cmd_build(args)
    "plan" => cmd_plan(args)
    "check" => cmd_check(args)
    "sync" => cmd_sync(args)
    "doctor" => cmd_doctor()
    "publish" => cmd_publish(args)
    "wizard" => cmd_wizard(args)
    _ => "Unknown command: \{command}\n\n" + format_help()
  }
}

///|
/// init 命令 — 生成真实可构建的跨平台项目骨架 | init command — generate a real buildable cross-platform project skeleton
pub async fn cmd_init(
  args : Array[String],
) -> String raise @core.MoonCrossError {
  let name = parse_arg(args, "--name", "mylib")
  let output_dir = parse_arg(args, "--output", name)
  let mut result = "Initializing project: \{name}\nOutput directory: \{output_dir}\n\n"
  // moon.mod（当前工具链 MoonBit DSL 格式） | moon.mod (current MoonBit DSL format)
  let moon_mod = "name = \"walkzzz/\{name}\"\n\nversion = \"0.1.0\"\n\nlicense = \"MIT\"\n\npreferred_target = \"native\"\n"
  ensure_dir(output_dir)
  write_file(output_dir + "/moon.mod", moon_mod)
  result = result + "  + moon.mod\n"
  // src/moon.pkg — foreign_library 包，产出静态库 | src/moon.pkg — foreign_library producing a static archive
  let moon_pkg = "pkgtype(kind: \"foreign_library\")\n\nsupported_targets = \"native\"\n"
  ensure_dir(output_dir + "/src")
  write_file(output_dir + "/src/moon.pkg", moon_pkg)
  result = result + "  + src/moon.pkg\n"
  // src/lib.mbt — 带 #export_name 的导出函数骨架 | src/lib.mbt — export skeleton with #export_name
  let mut lib = "// Generated by moon-cross init — 导出函数骨架 | export function skeleton\n\n"
  for func in default_init_functions() {
    lib = lib +
      "///|\n#export_name(\"\{name}_\{func.name}\")\npub fn \{func.name}(\{signature_of(func)}) -> \{func.return_type} {\n"
    lib = lib + "  \{body_of(func)}\n}\n\n"
  }
  write_file(output_dir + "/src/lib.mbt", lib)
  result = result +
    "  + src/lib.mbt (\{default_init_functions().length()} exported functions)\n"
  // moon-cross.json | cross config
  write_file(output_dir + "/moon-cross.json", json_of_functions(name))
  result = result + "  + moon-cross.json\n"
  // 构建说明 | build instructions
  let readme = "# \{name}\n\nGenerated by moon-cross init.\n\n## Build as native static library\n\n```bash\nmoon build --target native --release\n# artifact: _build/native/release/build/src/src.lib (Windows) / src.a (Unix)\n```\n\n## Generate platform bindings\n\n```bash\nmoon-cross build --config moon-cross.json --platform all --output moon-cross-output\n```\n"
  write_file(output_dir + "/README.md", readme)
  result = result + "  + README.md\n"
  result = result +
    "\nScaffold created successfully. Next: moon build --target native --release\n"
  result
}

///|
/// init 默认导出函数 | Default exported functions for init
fn default_init_functions() -> Array[@config.ExportFunction] {
  [
    {
      name: "add",
      params: [{ name: "a", typ: "Int", }, { name: "b", typ: "Int", }],
      return_type: "Int",
    },
    {
      name: "greet",
      params: [{ name: "name", typ: "String", }],
      return_type: "String",
    },
  ]
}

///|
/// 生成 MoonBit 函数参数签名 | Generate MoonBit function parameter signature
fn signature_of(func : @config.ExportFunction) -> String {
  let mut s = ""
  let mut first = true
  for p in func.params {
    if first {
      s = s + "\{p.name} : \{p.typ}"
      first = false
    } else {
      s = s + ", \{p.name} : \{p.typ}"
    }
  }
  s
}

///|
/// 生成函数默认实现体 | Generate default function body
fn body_of(func : @config.ExportFunction) -> String {
  match func.name {
    "add" => "a + b"
    "greet" => "\"hello \" + name"
    _ =>
      match func.return_type {
        "Int" => "0"
        "Double" => "0.0"
        "Bool" => "true"
        "String" => "\"\""
        _ => "abort(\"not implemented\")"
      }
  }
}

///|
/// 序列化 moon-cross.json 内容 | Serialize moon-cross.json content
fn json_of_functions(name : String) -> String {
  let mut s = "{\n  \"version\": 1,\n  \"module_path\": \"./\{name}\",\n  \"package_name\": \"walkzzz/\{name}\",\n  \"targets\": [\"ios\", \"android\", \"windows\", \"ohos\", \"linux\"],\n  \"functions\": [\n"
  let funcs = default_init_functions()
  let mut i = 0
  for func in funcs {
    s = s + "    {\n      \"name\": \"\{func.name}\",\n      \"params\": [\n"
    let mut j = 0
    for p in func.params {
      s = s +
        "        { \"name\": \"\{p.name}\", \"typ\": \"\{p.typ}\" }\{if j < func.params.length() - 1 { "," } else { "" }}\n"
      j = j + 1
    }
    s = s +
      "      ],\n      \"return_type\": \"\{func.return_type}\"\n    }\{if i < funcs.length() - 1 { "," } else { "" }}\n"
    i = i + 1
  }
  s = s + "  ],\n  \"types\": []\n}\n"
  s
}

///|
/// build 命令 — 读配置并真实生成产物落盘 | build command — load config and write real artifacts to disk
pub async fn cmd_build(
  args : Array[String],
) -> String raise @core.MoonCrossError {
  let config_path = parse_arg(args, "--config", "moon-cross.json")
  let platform = parse_arg(args, "--platform", "all")
  let output_dir = parse_arg(args, "--output", "moon-cross-output")
  let want_script = has_flag(args, "--script")
  let cfg = load_config(config_path)
  let module_name = cfg.module_path
  let mut result = "Building for platforms: \{platform}\nModule: \{module_name}\nConfig: \{config_path}\n\n"
  // C 适配层 | C adapter layer
  let funcs = to_codegen_functions(cfg.functions)
  let adapter = @codegen.generate_c_adapter(funcs, module_name)
  ensure_dir(output_dir)
  write_file(output_dir + "/" + adapter.filename, adapter.content)
  result = result +
    "Generated: \{output_dir}/\{adapter.filename} (\{adapter.content.length()} bytes)\n"
  // 各平台 FFI 绑定 | per-platform FFI bindings
  let codes = @codegen.generate_all_platforms(funcs, module_name)
  let binding_count = write_cross_platform_codes(output_dir, codes)
  result = result +
    "Generated: \{binding_count} platform binding files under \{output_dir}/\n"
  // Makefile | top-level Makefile
  let makefile = @codegen.generate_makefile(module_name)
  write_file(output_dir + "/" + makefile.filename, makefile.content)
  result = result + "Generated: \{output_dir}/\{makefile.filename}\n"
  if want_script {
    let build_cfg = @platform.default_build_config(module_name)
    let script = @platform.generate_build_script(build_cfg)
    write_file(output_dir + "/build.sh", script)
    result = result +
      "Generated: \{output_dir}/build.sh (\{script.length()} bytes)\n"
  }
  result = result +
    "\nBuild completed: \{1 + binding_count + 1} files in \{output_dir}/\n"
  result
}

///|
/// plan 命令 — 输出构建计划（dry-run，不落盘） | plan command — show build plan (dry-run, no disk writes)
pub async fn cmd_plan(
  args : Array[String],
) -> String raise @core.MoonCrossError {
  let config_path = parse_arg(args, "--config", "moon-cross.json")
  let cfg = load_config(config_path)
  let plan = @codegen.generate_build_plan(
    to_codegen_functions(cfg.functions),
    cfg.module_path,
  )
  "Build plan for \{cfg.module_path} (\{cfg.functions.length()} exported functions):\n\n" +
  plan.content
}

///|
/// check 命令 — 校验配置：函数名唯一性与类型映射有效性 | check command — validate config: unique function names and type mapping validity
pub async fn cmd_check(
  args : Array[String],
) -> String raise @core.MoonCrossError {
  let config_path = parse_arg(args, "--config", "moon-cross.json")
  let cfg = load_config(config_path)
  let problems = validate_config(cfg)
  if problems.is_empty() {
    "Config OK: \{config_path}\n  module: \{cfg.module_path}\n  package: \{cfg.package_name}\n  functions: \{cfg.functions.length()}\n  types: \{cfg.types.length()}\n  targets: \{cfg.targets.length()}\n"
  } else {
    let mut s = "Config has \{problems.length()} problem(s):\n"
    for p in problems {
      s = s + "  - \{p}\n"
    }
    s
  }
}

///|
/// 配置校验纯函数：函数名唯一性、类型映射有效性、平台有效性 | Pure config validation: unique names, type mapping validity, platform validity
pub fn validate_config(cfg : @config.CrossConfig) -> Array[String] {
  let problems : Array[String] = []
  // 函数名唯一性 | function name uniqueness
  let seen : Array[String] = []
  for func in cfg.functions {
    for prev in seen {
      if prev == func.name {
        problems.push("duplicate function name: \{func.name}")
      }
    }
    seen.push(func.name)
  }
  // 类型映射有效性 | type mapping validity
  let known = ["Int", "Double", "Bool", "Unit", "String", "Bytes"]
  for func in cfg.functions {
    match known.contains(func.return_type) {
      true => ()
      false =>
        problems.push(
          "function \{func.name}: unknown return type \{func.return_type}",
        )
    }
    for p in func.params {
      match known.contains(p.typ) {
        true => ()
        false =>
          problems.push(
            "function \{func.name}: unknown param type \{p.typ} for \{p.name}",
          )
      }
    }
  }
  // 平台有效性 | platform validity
  if cfg.targets.is_empty() {
    problems.push("no targets declared")
  }
  problems
}

///|
/// sync 命令 — 重新生成各平台绑定代码（不含 Makefile） | sync command — regenerate platform bindings (without Makefile)
pub async fn cmd_sync(
  args : Array[String],
) -> String raise @core.MoonCrossError {
  let config_path = parse_arg(args, "--config", "moon-cross.json")
  let output_dir = parse_arg(args, "--output", "moon-cross-output")
  let cfg = load_config(config_path)
  let codes = @codegen.generate_all_platforms(
    to_codegen_functions(cfg.functions),
    cfg.module_path,
  )
  let n = write_cross_platform_codes(output_dir, codes)
  "Synced \{n} platform binding files into \{output_dir}/ for \{cfg.module_path}\n"
}

///|
/// doctor 命令 — 检测 moon 工具链与 C 编译器，全部缺失时报错 | doctor command — detect moon toolchain and C compiler, raise when none found
pub async fn cmd_doctor() -> String raise @core.MoonCrossError {
  let mut report = "Moon Cross Doctor\n=================\n\n"
  // moon 工具链 | moon toolchain
  let moon_ok = probe_ok("moon", ["version"])
  report = report + "[moon toolchain]\n"
  report = report + probe_command("moon", ["version"])
  report = report + "\n[C compiler]\n"
  let cc_ok = probe_ok("clang-cl", ["--version"]) ||
    probe_ok("clang", ["--version"]) ||
    probe_ok("gcc", ["--version"]) ||
    probe_ok("cc", ["--version"])
  report = report + probe_command("clang-cl", ["--version"])
  report = report + probe_command("clang", ["--version"])
  report = report + probe_command("gcc", ["--version"])
  report = report + probe_command("cc", ["--version"])
  // moon 与编译器全部缺失时诊断失败 | raise when neither moon nor any C compiler is usable
  match moon_ok || cc_ok {
    true => ()
    false =>
      raise @core.ValidationError(
        "no usable moon/C toolchain found in PATH | PATH 中未找到可用的 moon/C 工具链",
      )
  }
  report = report + "\n[environment]\n"
  report = report + "  OS: \{platform_label()}\n"
  match @env.get_env_var("ANDROID_NDK_HOME") {
    Some(v) => report = report + "  ANDROID_NDK_HOME: \{v}\n"
    None =>
      report = report +
        "  ANDROID_NDK_HOME: (not set — Android cross-compile unavailable)\n"
  }
  match @env.get_env_var("OHOS_SDK") {
    Some(v) => report = report + "  OHOS_SDK: \{v}\n"
    None =>
      report = report +
        "  OHOS_SDK: (not set — HarmonyOS cross-compile unavailable)\n"
  }
  report
}

///|
/// 探测命令是否可用（退出码为 0 即可用） | Probe whether a command is usable (exit code 0)
async fn probe_ok(name : String, argv : Array[String]) -> Bool noraise {
  let outcome = Ok(
    @process.run(name, argv, stdout=@process.Discard, stderr=@process.Discard).exit_code,
  ) catch {
    _ => Err(())
  }
  match outcome {
    Ok(code) => code == 0
    Err(_) => false
  }
}

///|
/// 探测单个命令并返回报告行 | Probe a command and return a report line
async fn probe_command(name : String, argv : Array[String]) -> String noraise {
  let outcome = Ok(
    @process.run(name, argv, stdout=@process.Collect, stderr=@process.Discard),
  ) catch {
    _ => Err(())
  }
  match outcome {
    Ok(res) =>
      match res.exit_code {
        0 => {
          let text = res.stdout_text() catch { _ => "" }
          "  OK: \{name} — \{first_line(text)}\n"
        }
        code => "  WARN: \{name} exited with \{code}\n"
      }
    Err(_) => "  MISSING: \{name} not found in PATH\n"
  }
}

///|
/// 取多行文本第一行 | Take the first line of multi-line text
fn first_line(text : String) -> String {
  match text.split("\n").next() {
    Some(v) => v.to_owned()
    None => text
  }
}

///|
/// config 包导出函数转 codegen 包导出函数 | Convert config ExportFunction list to codegen ExportFunction list
fn to_codegen_functions(
  funcs : Array[@config.ExportFunction],
) -> Array[@codegen.ExportFunction] {
  let out : Array[@codegen.ExportFunction] = []
  for f in funcs {
    let params : Array[(String, String)] = []
    for p in f.params {
      params.push((p.name, p.typ))
    }
    out.push({ name: f.name, params, return_type: f.return_type, })
  }
  out
}

///|
/// 当前平台标签 | Current platform label
fn platform_label() -> String {
  match @env.get_env_var("OS") {
    Some(os) => os
    None =>
      match @env.get_env_var("HOME") {
        Some(_) => "unix-like"
        None => "unknown"
      }
  }
}

///|
/// publish 命令 — moon.mod 元数据预检 | publish command — moon.mod metadata pre-check
pub async fn cmd_publish(
  args : Array[String],
) -> String raise @core.MoonCrossError {
  let mod_path = parse_arg(args, "--mod", "moon.mod")
  let text = @fs.read_text(mod_path) catch {
    _ =>
      raise @core.IoError(
        "cannot read moon.mod at: \{mod_path} | 无法读取 moon.mod: \{mod_path}",
      )
  }
  let problems : Array[String] = []
  match text.contains("name = \"") {
    true => ()
    false => problems.push("missing `name` field in moon.mod")
  }
  match text.contains("version = \"") {
    true => ()
    false => problems.push("missing `version` field in moon.mod")
  }
  match text.contains("license = \"") {
    true => ()
    false =>
      problems.push(
        "missing `license` field (OSI license required by mooncakes)",
      )
  }
  match text.contains("username") {
    true =>
      problems.push(
        "namespace still uses template default `username` — replace with your account",
      )
    false => ()
  }
  if problems.is_empty() {
    "Publish readiness OK for \{mod_path}.\nNext steps:\n  1. moon login (mooncakes.io account)\n  2. moon check --deny-warn && moon test\n  3. moon publish\n"
  } else {
    let mut s = "Publish pre-check found \{problems.length()} problem(s):\n"
    for p in problems {
      s = s + "  - \{p}\n"
    }
    s
  }
}

///|
/// wizard 命令 — 非交互展示 init 执行计划 | wizard command — non-interactive preview of the init plan
pub fn cmd_wizard(args : Array[String]) -> String {
  let name = parse_arg(args, "--name", "mylib")
  let output_dir = parse_arg(args, "--output", name)
  let funcs = default_init_functions()
  let mut plan = "Init wizard plan (non-interactive preview)\n==========================================\n\n"
  plan = plan + "Project name: \{name}\nOutput directory: \{output_dir}\n\n"
  plan = plan + "Files that `moon-cross init --name \{name}` will write:\n"
  plan = plan +
    "  moon.mod                (module manifest, MoonBit DSL format)\n"
  plan = plan +
    "  src/moon.pkg            (foreign_library package producing a static archive)\n"
  plan = plan +
    "  src/lib.mbt             (\{funcs.length()} exported functions with #export_name)\n"
  for func in funcs {
    plan = plan +
      "    - \{func.name}(\{signature_of(func)}) -> \{func.return_type}  exported as \"\{name}_\{func.name}\"\n"
  }
  plan = plan +
    "  moon-cross.json         (cross-platform config for build/sync)\n"
  plan = plan + "  README.md               (build instructions)\n\n"
  plan = plan + "Run `moon-cross init --name \{name}` to execute this plan.\n"
  plan
}
